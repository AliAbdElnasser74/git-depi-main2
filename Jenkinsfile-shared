@Library('depi')_

pipeline {
    agent any

    tools {
        jdk 'JDK-11'
        maven 'maven-3-5-4'
    }

    stages {
        stage('Build java') {
            steps {
                script {
                    def ali = new com.depi.mvnClass()
                    ali.packageJar("-DskipTests")
                }
            }
        }
        stage('Test java') {
            steps {
                script {
                    def ali = new com.depi.mvnClass()
                    ali.testJar()
                }
            }
        }
        stage('Build docker') {
            steps {
                script {
                    def dockerAli = new com.depi.dockerClass()
                    dockerAli.dockerBuild("hassaneid/depi-java", "v${BUILD_NUMBER}")
                }
            }
        }
    }
}
